VITE_API_URL=http://localhost:8000

# Google OAuth client ID (see backend/.env.example's GOOGLE_OAUTH_CLIENT_ID
# - both must be the same value). Unset -> the Google Sign-In button in
# AuthPanel.jsx just doesn't render; email/password auth is unaffected.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
