# TAVILY_API_KEY=your_tavily_api_key_here   # optional - falls back to free DuckDuckGo/Wikipedia/Hacker News search if unset
GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here   # only needed if you switch LLM_MODEL to gemini/...
# LLM_MODEL=gemini/gemini-3.6-flash   # default is groq/qwen/qwen3.8-27b; override to switch providers/models
FRONTEND_ORIGIN=http://localhost:5173

# Last-resort local-model tier (see agent/llm.py's NeedsDeepAnalysisError) -
# only used once an email is on file for a request, since it's much slower
# than the cloud chain. Requires Ollama running locally with this model
# pulled (`ollama pull qwen2.5:7b`); unset if you don't want this tier at
# all - callers still get the deterministic fallback, just without a local
# retry first.
# LOCAL_LLM_MODEL=ollama/qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# LOCAL_LLM_TIMEOUT_SECONDS=240

# Signs the JWT auth tokens agent/auth.py issues on signup/login. Unset
# locally -> a fixed dev-only fallback (see auth.py), fine for local
# testing since nothing else depends on it staying secret. Render sets this
# to a generated random value automatically (see render.yaml) - it must be
# set explicitly on any other production deployment, since the fallback
# would let anyone forge a valid token for any account.
# AUTH_SECRET_KEY=

# Sessions, background jobs, and the /validate cache are stored here.
# Unset (or commented out) -> a local ./affinity.db SQLite file, good enough
# for local dev. Set to a Postgres URL in production (e.g. Render's
# internal database URL) so data survives a restart and is shared across
# every backend instance instead of living only in that instance's memory.
# DATABASE_URL=postgresql://user:password@host:5432/affinity

# Set to 1/true to make startup fail loudly instead of silently falling
# back to the local SQLite file when DATABASE_URL isn't set - useful on a
# host (like Render's free tier) with no persistent disk, where that
# fallback quietly loses every user, session and admin flag on redeploy.
# REQUIRE_PERSISTENT_DB=1

# Postgres connection pool size per backend instance (ignored for the
# SQLite fallback above). If running multiple instances, keep
# instances x (DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW) under your database
# plan's max connection count.
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
